NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://hirzexa.com

# Server-only endpoint that accepts contact enquiries and forwards them to the
# server-selected departmental alias supplied in `recipient`. Use an HTTPS URL in deployment.
CONTACT_WEBHOOK_URL=
# Optional shared secret sent in `x-hirzexa-webhook-secret` header to your relay endpoint.
CONTACT_WEBHOOK_SECRET=
# Enable ONLY after Google Workspace sender identity, "Send mail as", and SPF/DKIM/DMARC
# are verified for noreply@hirzexa.com (paired with departmental Reply-To).
VERIFIED_EMAIL_SENDER_ENABLED=false

# Server-only Gemini configuration. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Alternatively, use GOOGLE_GENERATIVE_AI_API_KEY instead of GEMINI_API_KEY.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_FEATURES_ENABLED=false
