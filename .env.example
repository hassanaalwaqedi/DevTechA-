NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Strictly server-only Supabase service_role key (NEVER prefix with NEXT_PUBLIC_).
# Required for server-verified webhooks, private CV uploads, and admin activation.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://hirzexa.com
APP_BASE_URL=https://hirzexa.com

# Security & Administrative Controls (server-only)
# Set to "required" after all admins enroll TOTP at /admin/mfa (default "enrolled_only" prevents rollout lockout).
ADMIN_MFA_ENFORCEMENT=enrolled_only
# 32+ byte random secret for HMAC-signing session revocation cookies and booking ICS links.
SESSION_SIGNING_SECRET=
# Comma-separated canonical Super Admin emails allowed legacy bootstrap.
SUPER_ADMIN_ALLOWLIST=
# Bearer secret for scheduled interview reminder dispatch (/api/admin/interviews/reminders/dispatch).
CRON_SECRET=

# Transactional Email (Resend, server-only)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Server-only endpoint that accepts contact enquiries and forwards them to the
# server-selected departmental alias supplied in `recipient`. Use an HTTPS URL in deployment.
CONTACT_WEBHOOK_URL=
# Optional shared secret sent in `x-hirzexa-webhook-secret` header to your relay endpoint.
CONTACT_WEBHOOK_SECRET=
# Optional: set to "resend" to route contact enquiries directly via Resend when webhook is unset.
CONTACT_DELIVERY_MODE=
# Enable ONLY after Google Workspace sender identity, "Send mail as", and SPF/DKIM/DMARC
# are verified for noreply@hirzexa.com (paired with departmental Reply-To).
VERIFIED_EMAIL_SENDER_ENABLED=false

# Server-only Gemini configuration. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Alternatively, use GOOGLE_GENERATIVE_AI_API_KEY instead of GEMINI_API_KEY.
GEMINI_MODEL=gemini-2.5-flash
AI_FEATURES_ENABLED=false
